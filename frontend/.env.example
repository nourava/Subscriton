# ==============================================================================
# Brightloop Subscription Management System - Global Environment Template
# Copy this file to .env and adjust values for your local environment
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Django REST Framework)
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=brightloop-dev-insecure-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Note: For development, if PostgreSQL is not running, the system safely falls back
# to local SQLite development database if DB_USE_SQLITE_FALLBACK=True.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=brightloop_db
DB_USER=brightloop_user
DB_PASSWORD=brightloop_password
DB_HOST=localhost
DB_PORT=5432
DB_USE_SQLITE_FALLBACK=True

# CORS Configuration (Frontend communication)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT / Token Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE="Brightloop Subscription Management System"
VITE_ENABLE_MOCK_DATA=False
